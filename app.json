{
  "expo": {
    "name": "Hemera",
    "slug": "hemera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hemera",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.busandcode.hemera",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.busandcode.hemera",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E23A2E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hemera to access your photos so you can set a profile picture.",
          "cameraPermission": "Allow Hemera to use your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hemera to use Face ID to unlock the app."
        }
      ],
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a83557ff-c600-4aec-bb48-61a1814d21b5"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "hemera-app",
    "updates": {
      "url": "https://u.expo.dev/a83557ff-c600-4aec-bb48-61a1814d21b5"
    }
  }
}
